# ═══════════════════════════════════════════════════════════════════════════
# kafka-inspect config -- every key here has a comment above it explaining what it
# does, its valid values, and what happens if it's left unset/commented out.
#
# Precedence, LAST wins: this file  <  SCANNER_* env vars  <  CLI flags.
#   SCANNER_TOPIC=orders                 overrides topic= below
#   --topic=orders                       overrides both of the above
#
# An unknown key in this file (e.g. a typo like "form=" instead of "from=")
# is a hard error at startup, not a warning -- a silently-ignored typo must
# never degrade into scanning the wrong thing and reporting a false "not
# found". This file is entirely optional: kafka-inspect runs fine with no file at
# all as long as --topic= and --kafka.bootstrap.servers= are given some
# other way (CLI or env).
# ═══════════════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────────────
#
# There's no safe guess for "which topic" or "which cluster" on a real host
# -- left unset (here, or via --topic=/--kafka.bootstrap.servers=/env),
# startup fails fast with a clear error naming exactly which one is missing,
# rather than silently scanning nothing in particular.

# topic=orders
# kafka.bootstrap.servers=localhost:9092

# ── Scan behavior ────────────────────────────────────────────────────────

# Where to start reading: earliest | latest | <epoch-ms>.
# earliest is the safer default for a tool whose whole job is "did this
# message land somewhere in this topic" -- latest would silently miss
# anything already there before kafka-inspect started.
from=earliest

# Keep polling for new records after reaching the current end (tail -f
# style) instead of stopping there. Stops cleanly on Ctrl-C/SIGTERM. An
# idle topic never triggers the stall-failure a bounded scan would.
# follow=false

# Stop after this many matches (0 = unlimited). With follow=true, this
# blocks until that many matches show up, then exits. Defaulted to 50 here
# so a zero-flag run doesn't read an entire large topic by surprise --
# the limit actually in effect is always shown in kafka-inspect's own stderr
# summary line, so a capped result is never silently mistaken for complete.
limit=50

# pretty (human-readable blocks), json (one NDJSON object per record), or
# count (just the integer match count, nothing else on stdout).
# output=pretty

# ── Filters ──────────────────────────────────────────────────────────────
#
# All given filters are ANDed together. With none set, every record
# matches (match.key/match.value/match.exact/match.case-sensitive have no
# env-var override for match.header/match.field -- see README's Filters
# section for why; those two are CLI-repeatable-flag or numbered-key-here
# only).

# Exact text (well, substring -- see below) to look for in the record key.
# match.key=1003

# Substring to look for anywhere in the whole record value -- no JSON path
# needed, and works on non-JSON values too (unlike match.field below).
# match.value=brothers

# match.key/match.value/match.header default to case-insensitive SUBSTRING
# matching (--match.key=order matches a key of ORDER-123). Set to true to
# require the full value instead of a substring, or to compare
# case-sensitively.
# match.exact=false
# match.case-sensitive=false

# Header filters: name=value, one per numbered key (order doesn't matter,
# they're ANDed together either way). A record missing the header never
# matches -- that's different from an empty/wrong value.
# match.header.0=source=web
# match.header.1=env=prod

# JSON-field filters on the record value, dotted-path: path=value (equals),
# path!=value (not-equals, and a missing path never matches this either),
# or path~regex (substring/contains regex, e.g. id~^10 matches "1001").
# A non-JSON record value is skipped (never matches), not an error.
# match.field.0=customer.id=c-42
# match.field.1=status!=NEW

# ── kafka.* passthrough ──────────────────────────────────────────────────
#
# Anything after "kafka." is passed straight through to the underlying
# Kafka client with the prefix stripped -- no code changes needed for new
# security settings. A few hard pins are always applied on top, no matter
# what's set here: no group.id, enable.auto.commit=false,
# allow.auto.create.topics=false (see the design doc for why).

# --- SASL_PLAINTEXT, PLAIN mechanism (username/password) ------------------
# kafka.security.protocol=SASL_PLAINTEXT
# kafka.sasl.mechanism=PLAIN
# kafka.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \
#     username="scanner" \
#     password="change-me";

# --- SASL_PLAINTEXT, Kerberos (GSSAPI), JAAS config inlined ----------------
# No external file needed -- the keytab path isn't a secret, just a
# filesystem path, so this is usually the simplest way to wire up Kerberos.
# kafka.security.protocol=SASL_PLAINTEXT
# kafka.sasl.mechanism=GSSAPI
# kafka.sasl.kerberos.service.name=kafka
# kafka.sasl.jaas.config=com.sun.security.auth.module.Krb5LoginModule required \
#     useKeyTab=true \
#     storeKey=true \
#     keyTab="/etc/kafka-inspect/kafka-inspect.keytab" \
#     principal="kafka-inspect/your-host@YOUR-REALM.COM";

# --- SASL_PLAINTEXT, Kerberos (GSSAPI), external JAAS conf file ------------
# Use this style instead if your ops team already centrally manages a JAAS
# conf file (e.g. the classic kafka_client_jaas.conf -- see
# kafka_client_jaas.conf.example next to this file for its contents).
# java.security.auth.login.config and java.security.krb5.conf are JVM
# system properties, not Kafka client properties, so they go through the
# separate "jvm.*" passthrough below instead of "kafka.*".
# kafka.security.protocol=SASL_PLAINTEXT
# kafka.sasl.mechanism=GSSAPI
# kafka.sasl.kerberos.service.name=kafka
# jvm.java.security.auth.login.config=/etc/kafka-inspect/kafka_client_jaas.conf
# jvm.java.security.krb5.conf=/etc/krb5.conf

# ── jvm.* passthrough ─────────────────────────────────────────────────────
#
# Anything after "jvm." is applied as a JVM system property
# (System.setProperty) before the Kafka consumer is built -- for the rare
# settings Kerberos/SASL need that aren't themselves Kafka client
# properties. Same prefix-stripping convention as kafka.* above.
