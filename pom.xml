<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>kscan</groupId>
  <artifactId>kscan</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <properties>
    <!-- VERSION (repo root) is the single source of truth: release builds pass
         -Drevision=$(cat VERSION) (see packaging/build-rpm.sh) so the two can
         never drift apart. This default only covers a plain "mvn package" run
         where nobody bothered to pass it; keep it in sync with VERSION by hand
         for that case, same as before: it's not load-bearing for the RPM. -->
    <revision>0.1.0</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <kafka.clients.version>3.9.2</kafka.clients.version>
    <!-- Must track whatever slf4j-api version kafka-clients pulls in transitively
         (checked via `mvn dependency:tree`: kafka-clients 3.9.2 pulls 1.7.36,
         NOT a 2.x), so slf4j-simple actually binds instead of silently
         degrading to NOP logging. -->
    <slf4j.version>1.7.36</slf4j.version>
    <junit.version>5.11.3</junit.version>
    <!-- 2.x line only: Jackson 3.x requires Java 17+, same trap as Kafka 4.x/slf4j 2.x. -->
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.clients.version}</version>
    </dependency>

    <!-- match.field JSON path navigation (jackson-core/jackson-annotations come in transitively). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Binds kafka-clients' slf4j-api so its WARN/ERROR connection and
         coordinator logs surface on stderr instead of being silently
         dropped (NOP) or printing a one-time "no provider" notice. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- Copies scanner.properties next to the built jar (target/), NOT inside it:
           it must stay an external, independently editable file, matching how the RPM
           installs it outside the jar too. This is what makes ConfigBuilder's
           install-relative default config path actually find it when running the
           jar directly, with no explicit "config" flag needed. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-default-config-next-to-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>scanner.properties</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Produces the single fat/shaded jar the RPM ships: no runtime
           dependency resolution needed on the target host. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- This is an application, not a library anyone else's build will depend on:
                   the reduced POM has no consumer, so skip generating dependency-reduced-pom.xml. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>kscan.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
