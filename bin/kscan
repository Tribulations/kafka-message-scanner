#!/usr/bin/env bash
#
# kscan wrapper: resolves a Java 8-or-newer runtime and execs the shaded jar,
# injecting the RPM-installed default config path if the caller didn't
# supply one. Java 8 is a floor, not an exact requirement -- the jar is
# compiled to Java 8 bytecode so it also runs fine on anything newer.
# Java resolution order: $KSCAN_JAVA_HOME, then /etc/alternatives/java, then
# $PATH, then two hardcoded Java-8-specific fallback paths as a last resort.
#
# Expected install layout (see packaging/kscan.spec):
#   /opt/kscan/kscan.jar
#   /opt/kscan/bin/kscan          <- this script
#   /usr/bin/kscan                <- symlink to the above, for PATH convenience
#   /etc/kscan/scanner.properties <- default config (RPM-managed, %config(noreplace))
set -euo pipefail

# Last-resort fallback paths, tried only if /etc/alternatives/java and $PATH
# (see the resolution order below) both come up empty. Both layouts have been
# seen in practice (confirmed in a UBI9 container): RHEL/CentOS 7-era
# full-JDK packages create the plain "java-1.8.0-openjdk" name, while a
# RHEL/CentOS 9-era "java-1.8.0-openjdk-headless" install only creates the
# "jre-1.8.0-openjdk" alternatives symlink -- there is no plain
# "java-1.8.0-openjdk" at all in that case. Try both.
DEFAULT_JAVA_HOME_CANDIDATES=(
    "/usr/lib/jvm/java-1.8.0-openjdk"
    "/usr/lib/jvm/jre-1.8.0-openjdk"
)
DEFAULT_CONFIG="/etc/kscan/scanner.properties"

# readlink -f follows the /usr/bin/kscan symlink to its real location before
# deriving the install directory -- a bare "dirname "$0"" would instead
# resolve against /usr/bin and never find the jar next to the real script.
script_path="$(readlink -f "$0")"
install_dir="$(dirname "$(dirname "$script_path")")"
jar_path="$install_dir/kscan.jar"

if [ ! -f "$jar_path" ]; then
    echo "kscan: cannot find $jar_path (expected next to this script's install directory)" >&2
    exit 2
fi

java_bin=""
if [ -n "${KSCAN_JAVA_HOME:-}" ]; then
    java_bin="$KSCAN_JAVA_HOME/bin/java"
    if [ ! -x "$java_bin" ]; then
        echo "kscan: no usable java found at $java_bin (from KSCAN_JAVA_HOME)" >&2
        exit 2
    fi
else
    # Resolution order, each tried only if the previous found nothing:
    #   1. /etc/alternatives/java -- the RHEL/Debian alternatives system's
    #      symlink to whatever Java the host's package manager/admin has
    #      configured as the system default, regardless of vendor/version.
    #   2. whatever "java" resolves to on $PATH -- catches non-RHEL hosts,
    #      tarball installs, and vendor JDKs that don't register with
    #      alternatives.
    #   3. the two hardcoded Java-8-specific paths above, as a last resort.
    # The version check below still rejects anything found this way that's
    # older than Java 8 or unparseable -- this only widens WHERE a valid
    # runtime can be found, not what counts as valid.
    if [ -x /etc/alternatives/java ]; then
        java_bin="/etc/alternatives/java"
    elif command -v java >/dev/null 2>&1; then
        java_bin="$(command -v java)"
    else
        for candidate in "${DEFAULT_JAVA_HOME_CANDIDATES[@]}"; do
            if [ -x "$candidate/bin/java" ]; then
                java_bin="$candidate/bin/java"
                break
            fi
        done
    fi
    if [ -z "$java_bin" ]; then
        echo "kscan: no usable java found (checked /etc/alternatives/java, \$PATH, and: ${DEFAULT_JAVA_HOME_CANDIDATES[*]}) -- set KSCAN_JAVA_HOME to a Java 8+ install" >&2
        exit 2
    fi
fi

# Version check: Java 8 is the FLOOR, not an exact requirement -- the jar is
# compiled to Java 8 bytecode specifically so it also runs on anything newer
# (9, 11, 17, 21, ...), which the JVM has always guaranteed. Only reject
# something OLDER than 8, or a version string that can't be parsed at all
# (fail safe rather than silently run under something unverified). Skips any
# "Picked up JAVA_TOOL_OPTIONS" noise line some environments print to stderr
# before the real "java version ..." line.
version_line="$("$java_bin" -version 2>&1 | grep -m1 'version "' || true)"
version_string="$(printf '%s' "$version_line" | sed -n 's/.*version "\([^"]*\)".*/\1/p')"

if [ -z "$version_string" ]; then
    echo "kscan: could not determine the Java version at $java_bin (output: ${version_line:-none}) -- set KSCAN_JAVA_HOME to a Java 8+ install" >&2
    exit 2
fi

# Old-style versions (Java 8 and earlier) look like "1.8.0_452" -- the major
# version is the SECOND component. New-style versions (Java 9+, JEP 223)
# look like "11.0.2" or just "21" -- the major version is the FIRST component.
case "$version_string" in
    1.*)
        major="$(printf '%s' "$version_string" | cut -d. -f2)"
        ;;
    *)
        major="$(printf '%s' "$version_string" | cut -d. -f1)"
        ;;
esac

if ! printf '%s' "$major" | grep -Eq '^[0-9]+$'; then
    echo "kscan: could not parse the Java major version from '$version_string' at $java_bin -- set KSCAN_JAVA_HOME to a Java 8+ install" >&2
    exit 2
fi

if [ "$major" -lt 8 ]; then
    echo "kscan: $java_bin is Java $major, older than the minimum supported version (8) -- set KSCAN_JAVA_HOME to a Java 8+ install" >&2
    exit 2
fi

# Only inject the RPM-installed default config if the caller didn't already
# pass their own --config= and that default actually exists -- this keeps the
# wrapper working when it's copied/tested outside of an RPM install too (no
# /etc/kscan, so kscan.jar's own install-relative lookup takes over instead).
config_args=()
if [ -f "$DEFAULT_CONFIG" ]; then
    has_config_flag=0
    for arg in "$@"; do
        case "$arg" in
            --config=*) has_config_flag=1 ;;
        esac
    done
    if [ "$has_config_flag" -eq 0 ]; then
        config_args=(--config="$DEFAULT_CONFIG")
    fi
fi

exec "$java_bin" -jar "$jar_path" "${config_args[@]}" "$@"
