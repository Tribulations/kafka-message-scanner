#!/usr/bin/env bash
#
# kscan wrapper: resolves a Java 8 runtime and execs the shaded jar, injecting
# the RPM-installed default config path if the caller didn't supply one.
#
# Expected install layout (see packaging/kscan.spec):
#   /opt/kscan/kscan.jar
#   /opt/kscan/bin/kscan          <- this script
#   /usr/bin/kscan                <- symlink to the above, for PATH convenience
#   /etc/kscan/scanner.properties <- default config (RPM-managed, %config(noreplace))
set -euo pipefail

# Both layouts have been seen in practice (confirmed in a UBI9 container):
# RHEL/CentOS 7-era full-JDK packages create the plain "java-1.8.0-openjdk"
# name, while a RHEL/CentOS 9-era "java-1.8.0-openjdk-headless" install only
# creates the "jre-1.8.0-openjdk" alternatives symlink -- there is no plain
# "java-1.8.0-openjdk" at all in that case. Try both; KSCAN_JAVA_HOME always
# wins over either.
DEFAULT_JAVA_HOME_CANDIDATES=(
    "/usr/lib/jvm/java-1.8.0-openjdk"
    "/usr/lib/jvm/jre-1.8.0-openjdk"
)
DEFAULT_CONFIG="/etc/kscan/scanner.properties"

# readlink -f follows the /usr/bin/kscan symlink to its real location before
# deriving the install directory -- a bare "dirname "$0"" would instead
# resolve against /usr/bin and never find the jar next to the real script.
script_path="$(readlink -f "$0")"
install_dir="$(dirname "$(dirname "$script_path")")"
jar_path="$install_dir/kscan.jar"

if [ ! -f "$jar_path" ]; then
    echo "kscan: cannot find $jar_path (expected next to this script's install directory)" >&2
    exit 2
fi

java_bin=""
if [ -n "${KSCAN_JAVA_HOME:-}" ]; then
    java_bin="$KSCAN_JAVA_HOME/bin/java"
    if [ ! -x "$java_bin" ]; then
        echo "kscan: no usable java found at $java_bin (from KSCAN_JAVA_HOME)" >&2
        exit 2
    fi
else
    for candidate in "${DEFAULT_JAVA_HOME_CANDIDATES[@]}"; do
        if [ -x "$candidate/bin/java" ]; then
            java_bin="$candidate/bin/java"
            break
        fi
    done
    if [ -z "$java_bin" ]; then
        echo "kscan: no usable java found at any of: ${DEFAULT_JAVA_HOME_CANDIDATES[*]} -- set KSCAN_JAVA_HOME to a Java 8 install" >&2
        exit 2
    fi
fi

# Defensive version check: accepts old-style "1.8.x" and new-style "8.x"
# major versions, and skips any "Picked up JAVA_TOOL_OPTIONS" noise line some
# environments print to stderr before the real "java version ..." line.
version_line="$("$java_bin" -version 2>&1 | grep -m1 'version "' || true)"
if ! printf '%s' "$version_line" | grep -Eq 'version "(1\.8\.|8\.)'; then
    echo "kscan: $java_bin is not Java 8 (found: ${version_line:-no version output}) -- set KSCAN_JAVA_HOME to a Java 8 install" >&2
    exit 2
fi

# Only inject the RPM-installed default config if the caller didn't already
# pass their own --config= and that default actually exists -- this keeps the
# wrapper working when it's copied/tested outside of an RPM install too (no
# /etc/kscan, so kscan.jar's own install-relative lookup takes over instead).
config_args=()
if [ -f "$DEFAULT_CONFIG" ]; then
    has_config_flag=0
    for arg in "$@"; do
        case "$arg" in
            --config=*) has_config_flag=1 ;;
        esac
    done
    if [ "$has_config_flag" -eq 0 ]; then
        config_args=(--config="$DEFAULT_CONFIG")
    fi
fi

exec "$java_bin" -jar "$jar_path" "${config_args[@]}" "$@"
